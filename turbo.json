{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI", "PLAYWRIGHT_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "BLUEPRINT_WORKSPACE",
        "BLUEPRINT_STATIC",
        "BLUEPRINT_AUDIENCE",
        "NEXT_PUBLIC_DOCS_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "STUDIO_VERSION"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
